// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  slug    String   @id
  name    String
  sectors String[] @default(["Other"])

  jobs       Job[]
  scrapeRuns ScrapeRun[]

  @@map("companies")
}

model Job {
  id            Int       @id @default(autoincrement())
  companyId     String    @map("company_id")
  externalId    String    @map("external_id")
  title         String
  url           String
  location      String
  category      String
  postedDate    DateTime? @map("posted_date") @db.Date
  firstSeenAt   DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  isActive      Boolean   @default(true) @map("is_active")
  applied       Boolean   @default(false)
  appliedAt     DateTime? @map("applied_at")
  willApply     Boolean   @default(true) @map("will_apply")
  platform      String
  // "Software" or "Data", from the job title; set by the scraper (see
  // job_field in scraper/scrapers/base.py) for the UI's Field filter.
  field         String    @default("Software")
  // Canadian cities in `location`, plus "Remote"; set by the scraper (see
  // job_cities in scraper/scrapers/base.py) for the UI's City filter.
  cities        String[]  @default([])

  company Company @relation(fields: [companyId], references: [slug])

  @@unique([companyId, externalId])
  @@map("jobs")
}

model ScrapeRun {
  id           Int       @id @default(autoincrement())
  companyId    String    @map("company_id")
  startedAt    DateTime  @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  status       String
  errorMessage String?   @map("error_message")

  company Company @relation(fields: [companyId], references: [slug])

  @@map("scrape_runs")
}

// On-demand scan requests from the "Run Job Scan" button. The web app only
// inserts a row here; the scraper's own scheduler polls for pending rows and
// runs the scan — web and scraper still never call each other directly, only
// through Postgres, per the architecture in CLAUDE.md.
model ScrapeRequest {
  id           Int       @id @default(autoincrement())
  requestedAt  DateTime  @default(now()) @map("requested_at")
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  status       String    @default("pending") // pending | running | done | error
  errorMessage String?   @map("error_message")

  @@map("scrape_requests")
}
