// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  slug    String   @id
  name    String
  sectors String[] @default(["Other"])

  jobs       Job[]
  scrapeRuns ScrapeRun[]

  @@map("companies")
}

model Job {
  id            Int       @id @default(autoincrement())
  companyId     String    @map("company_id")
  externalId    String    @map("external_id")
  title         String
  url           String
  location      String
  category      String
  postedDate    DateTime? @map("posted_date") @db.Date
  firstSeenAt   DateTime  @default(now()) @map("first_seen_at")
  lastSeenAt    DateTime  @default(now()) @map("last_seen_at")
  isActive      Boolean   @default(true) @map("is_active")
  applied       Boolean   @default(false)
  appliedAt     DateTime? @map("applied_at")
  willApply     Boolean   @default(true) @map("will_apply")
  platform      String
  // "Software" or "Data", from the job title; set by the scraper (see
  // job_field in scraper/scrapers/base.py) for the UI's Field filter.
  field         String    @default("Software")
  // Canadian cities in `location`, plus "Remote"; set by the scraper (see
  // job_cities in scraper/scrapers/base.py) for the UI's City filter.
  cities        String[]  @default([])

  // Plain-text job description, fetched once by the scraper when the job
  // is first seen (see scraper/descriptions.py). The scraper gives up after
  // 3 failed attempts, and the job is then scored on its title alone.
  description         String?
  descriptionAttempts Int     @default(0) @map("description_attempts")

  // AI relevance score (0-100) against the resume for this job's `field`;
  // only ever written by the web app's scoring worker (src/lib/scoring).
  score         Int?
  scoreReason   String?   @map("score_reason")
  matchedSkills String[]  @default([]) @map("matched_skills")
  missingSkills String[]  @default([]) @map("missing_skills")
  // "description", or "title" when no description was available.
  scoreBasis    String?   @map("score_basis")
  // Hash of the resume, model and prompt version the score came from; a
  // job is re-scored when its field's current key differs.
  scoreKey      String?   @map("score_key")
  scoredAt      DateTime? @map("scored_at")

  company Company @relation(fields: [companyId], references: [slug])

  @@unique([companyId, externalId])
  @@map("jobs")
}

model ScrapeRun {
  id           Int       @id @default(autoincrement())
  companyId    String    @map("company_id")
  startedAt    DateTime  @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  status       String
  errorMessage String?   @map("error_message")

  company Company @relation(fields: [companyId], references: [slug])

  @@map("scrape_runs")
}

// On-demand scan requests from the "Run Job Scan" button. The web app only
// inserts a row here; the scraper's own scheduler polls for pending rows and
// runs the scan — web and scraper still never call each other directly, only
// through Postgres, per the architecture in CLAUDE.md.
model ScrapeRequest {
  id           Int       @id @default(autoincrement())
  requestedAt  DateTime  @default(now()) @map("requested_at")
  startedAt    DateTime? @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  status       String    @default("pending") // pending | running | done | error
  errorMessage String?   @map("error_message")

  @@map("scrape_requests")
}

// The resume each job is scored against, one per jobs.field ("Software" /
// "Data"), fetched from RESUME_URL_SOFTWARE / RESUME_URL_DATA by the scoring
// worker.
model Resume {
  field     String   @id
  text      String
  hash      String
  fetchedAt DateTime @map("fetched_at")

  @@map("resumes")
}

// Single row (id = 1) holding the scoring worker's last error.
model ScoringState {
  id          Int       @id
  lastError   String?   @map("last_error")
  lastErrorAt DateTime? @map("last_error_at")

  @@map("scoring_state")
}
